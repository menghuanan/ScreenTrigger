<UserControl x:Class="ScreenTrigger.Recognition.RecognitionPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Margin="24" Spacing="10">
   <TextBlock Text="测试识别" Style="{ThemeResource TitleTextBlockStyle}" />
   <ComboBox x:Name="Targets" Header="目标或编辑中的草稿" HorizontalAlignment="Stretch" />
   <TextBlock x:Name="FrameLabel" Text="测试图像取自「截图与导入」。" />
   <StackPanel Orientation="Horizontal" Spacing="8">
     <Button x:Name="Run" Content="测试当前图片" Click="Evaluate" AutomationProperties.AutomationId="TestRecognition"/>
     <Button x:Name="Cancel" Content="取消测试" IsEnabled="False" Click="CancelJob"/>
   </StackPanel>
   <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <Viewbox Stretch="Uniform" MaxHeight="340" HorizontalAlignment="Left">
     <Canvas x:Name="FrameCanvas"><Image x:Name="FrameImage" Stretch="Fill" /></Canvas>
   </Viewbox>
   <ListView x:Name="Evidence" AutomationProperties.Name="命中与逐条件证据" SelectionMode="None" />
 </StackPanel></ScrollViewer>
</UserControl>
