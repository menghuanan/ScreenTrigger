<UserControl x:Class="ScreenTrigger.RunContext.RunContextPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:monitor="using:ScreenTrigger.Monitor" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Margin="24" Spacing="10">
    <TextBlock x:Name="Heading" Text="运行设置" Style="{ThemeResource TitleTextBlockStyle}" />
    <TextBlock x:Name="OcrNotice" TextWrapping="Wrap" Visibility="Collapsed" Text="OCR 不可用。仍可使用纯脚本、模板、颜色和轮廓目标。" />
    <ComboBox x:Name="Windows" Header="已打开的窗口" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WindowPicker" />
    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="刷新窗口" Click="Refresh" />
        <Button Content="绑定窗口" Click="Bind" />
        <Button Content="解除绑定" Click="Unbind" />
    </StackPanel>
    <TextBlock x:Name="BindingLabel" AutomationProperties.AutomationId="WindowBinding" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox x:Name="BackgroundMode" Content="在后台读取和操作绑定窗口" IsEnabled="False" AutomationProperties.AutomationId="WindowBackgroundMode" />
        <Button x:Name="CheckCapture" Content="测试后台取像" IsEnabled="False" Click="TestBackgroundCapture" />
        <Button x:Name="CheckInput" Content="查询后台动作支持" IsEnabled="False" Click="CheckBackgroundInput" AutomationProperties.AutomationId="WindowInputCapabilities" />
    </StackPanel>
    <ComboBox x:Name="Displays" Header="未绑定时使用的显示器" HorizontalAlignment="Stretch" />
    <ComboBox x:Name="Scripts" Header="运行脚本" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RunScriptPicker" />
    <ComboBox x:Name="Mode" Header="运行模式" SelectedIndex="0" SelectionChanged="ChangeMode">
        <ComboBoxItem Content="单次" Tag="once" /><ComboBoxItem Content="指定次数" Tag="count" />
        <ComboBoxItem Content="持续运行" Tag="forever" /><ComboBoxItem Content="检测到目标即停止" Tag="until_target" />
    </ComboBox>
    <NumberBox x:Name="Count" Header="迭代次数" Minimum="1" Value="1" Visibility="Collapsed" />
    <ComboBox x:Name="Targets" Header="停止目标" HorizontalAlignment="Stretch" Visibility="Collapsed" />
    <TextBox x:Name="Arguments" Header="脚本参数（JSON 对象）" Text="{}" />
    <StackPanel x:Name="RecordingControls" Spacing="6">
        <TextBlock Text="录制当前范围" FontWeight="SemiBold" />
        <TextBlock Text="在当前桌面录制鼠标。已接入录制协议的焦点控件还可录普通键；其他受支持控件可录功能键和快捷键。" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="StartRecording" AutomationProperties.AutomationId="StartRecording" Click="RecordClick" Content="开始录制" />
            <Button x:Name="PauseRecording" AutomationProperties.AutomationId="PauseRecording" Click="RecordClick" Content="暂停" IsEnabled="False" />
            <Button x:Name="ResumeRecording" AutomationProperties.AutomationId="ResumeRecording" Click="RecordClick" Content="恢复" IsEnabled="False" />
            <Button x:Name="FinishRecording" AutomationProperties.AutomationId="FinishRecording" Click="RecordClick" Content="结束录制" IsEnabled="False" />
            <Button x:Name="CancelRecording" AutomationProperties.AutomationId="CancelRecording" Click="RecordClick" Content="取消录制" IsEnabled="False" />
        </StackPanel>
        <StackPanel Spacing="6">
            <ComboBox x:Name="IsolatedScope" Header="隔离桌面录制范围" SelectedIndex="0"
                      SelectionChanged="ChangeIsolatedScope" AutomationProperties.AutomationId="IsolatedRecordingScope">
                <ComboBoxItem Content="新启动应用的主窗口" Tag="window" />
                <ComboBoxItem Content="框选区域" Tag="region" />
                <ComboBoxItem Content="单台显示器" Tag="display" />
            </ComboBox>
            <ComboBox x:Name="IsolatedDisplay" Header="录制显示器" Visibility="Collapsed"
                      AutomationProperties.AutomationId="IsolatedRecordingDisplay" />
            <Button x:Name="PickIsolatedRegion" Content="框选录制区域" Visibility="Collapsed" Click="SelectRegion"
                    AutomationProperties.AutomationId="PickIsolatedRecordingRegion" />
            <TextBlock x:Name="IsolatedRegionLabel" Visibility="Collapsed" TextWrapping="Wrap" />
            <Button x:Name="StartIsolated" Content="选择应用并在隔离桌面录制" Click="RecordClick"
                    AutomationProperties.AutomationId="StartIsolatedRecording" />
            <TextBlock Text="请选择本机的图形界面应用（.exe）。应用会在隔离桌面启动。录英文按键前请确认目标应用已切换至英文输入法。停录时会关闭本次启动的应用，请先保存工作，再点击隔离桌面上的停止按钮，返回此页查看草稿。" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="RecordingStatus" AutomationProperties.AutomationId="RecordingStatus" TextWrapping="Wrap" />
        <Button x:Name="EditRecordingScript" Content="编辑为 Lua 脚本" Visibility="Collapsed" Click="EditRecording"
                AutomationProperties.AutomationId="EditRecordingScript" />
        <Expander x:Name="RecordingDraft" Header="查看已录动作" Visibility="Collapsed" Expanding="ReadRecordingDraft"
                  AutomationProperties.AutomationId="RecordingDraft" HorizontalAlignment="Stretch">
            <TextBox x:Name="RecordingActions" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220"
                     AutomationProperties.Name="已录动作 JSON" AutomationProperties.AutomationId="RecordingActions" />
        </Expander>
    </StackPanel>
    <monitor:MonitorOptions x:Name="Policy" Visibility="Collapsed" />
    <StackPanel Spacing="6">
        <ComboBox x:Name="OutputMode" Header="OCR 文字导出" SelectedIndex="0"
                  SelectionChanged="ChangeOutputMode" AutomationProperties.AutomationId="OutputMode">
            <ComboBoxItem Content="追加到文件" Tag="append" /><ComboBoxItem Content="覆盖文件" Tag="overwrite" />
        </ComboBox>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PickOutput" Content="选择 TXT 文件" Click="PickTextOutput" AutomationProperties.AutomationId="PickTextOutput" />
            <Button x:Name="ClearOutput" Content="取消导出" Click="ClearTextOutput" IsEnabled="False" AutomationProperties.AutomationId="ClearTextOutput" />
        </StackPanel>
        <TextBlock x:Name="OutputStatus" Text="未选择输出文件" TextWrapping="Wrap" AutomationProperties.AutomationId="TextOutputStatus" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="WriteStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.AutomationId="TextWriteStatus" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <Expander x:Name="Scope" Header="区域与频率" HorizontalAlignment="Stretch"><StackPanel Spacing="8">
        <TextBox x:Name="Region" Header="识别区域（Region JSON，留空使用整个显示器或客户区）"
                 AutomationProperties.AutomationId="Region"
                 PlaceholderText='绑定窗口可填客户区矩形，例如 {"x":0,"y":0,"width":320,"height":180}' />
        <Button x:Name="PickRegion" Content="在显示器上框选区域" Click="SelectRegion" />
        <CheckBox x:Name="AllowExit" Content="允许输入越出识别区域" />
        <NumberBox x:Name="Frequency" Header="识别频率（Hz）" Minimum="0.1" Maximum="30" Value="1" />
        <NumberBox x:Name="Timeout" Header="总期限（毫秒，0 表示不限）" Minimum="0" Value="0" />
    </StackPanel></Expander>
    <CheckBox x:Name="EnableDebug" Content="启用已保存源码的断点" />
    <TextBlock Text="启动时固定目标、脚本和区域快照。本页修改用于下一次运行。" TextWrapping="Wrap" />
    <Button x:Name="Execute" Content="运行脚本" Style="{StaticResource AccentButtonStyle}" Click="StartRun" AutomationProperties.AutomationId="ExecuteScript" />
    <Button Content="重置本次草稿" Click="ResetDraft" />
    <TextBlock x:Name="Observation" TextWrapping="Wrap" AutomationProperties.AutomationId="MonitorObservation" />
    <Expander Header="全局快捷键" HorizontalAlignment="Stretch"><StackPanel Spacing="8">
        <TextBox x:Name="SelectionKey" Header="开始框选" />
        <TextBox x:Name="StopKey" Header="停止全部脚本" />
        <TextBox x:Name="PauseKey" Header="暂停或恢复选中的脚本" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="保存快捷键" Click="SaveKeys" /><Button Content="撤销编辑" Click="ReloadKeys" />
        </StackPanel>
    </StackPanel></Expander>
    <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="RunFeedback" />
 </StackPanel></ScrollViewer>
</UserControl>
