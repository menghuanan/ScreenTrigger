<UserControl x:Class="ScreenTrigger.RunContext.RunContextPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:monitor="using:ScreenTrigger.Monitor" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Margin="24" Spacing="10">
    <TextBlock x:Name="Heading" Text="运行设置" Style="{ThemeResource TitleTextBlockStyle}" />
    <TextBlock x:Name="OcrNotice" TextWrapping="Wrap" Visibility="Collapsed" Text="OCR 不可用。仍可使用纯脚本、模板、颜色和轮廓目标。" />
    <ComboBox x:Name="Windows" Header="已打开的窗口" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WindowPicker" />
    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="刷新窗口" Click="Refresh" />
        <Button Content="绑定窗口" Click="Bind" />
        <Button Content="解除绑定" Click="Unbind" />
    </StackPanel>
    <TextBlock x:Name="BindingLabel" AutomationProperties.AutomationId="WindowBinding" TextWrapping="Wrap" />
    <ComboBox x:Name="Displays" Header="未绑定时使用的显示器" HorizontalAlignment="Stretch" />
    <ComboBox x:Name="Scripts" Header="运行脚本" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RunScriptPicker" />
    <ComboBox x:Name="Mode" Header="运行模式" SelectedIndex="0" SelectionChanged="ChangeMode">
        <ComboBoxItem Content="单次" Tag="once" /><ComboBoxItem Content="指定次数" Tag="count" />
        <ComboBoxItem Content="持续运行" Tag="forever" /><ComboBoxItem Content="检测到目标即停止" Tag="until_target" />
    </ComboBox>
    <NumberBox x:Name="Count" Header="迭代次数" Minimum="1" Value="1" Visibility="Collapsed" />
    <ComboBox x:Name="Targets" Header="停止目标" HorizontalAlignment="Stretch" Visibility="Collapsed" />
    <TextBox x:Name="Arguments" Header="脚本参数（JSON 对象）" Text="{}" />
    <monitor:MonitorOptions x:Name="Policy" Visibility="Collapsed" />
    <Expander x:Name="Scope" Header="区域与频率" HorizontalAlignment="Stretch"><StackPanel Spacing="8">
        <TextBox x:Name="Region" Header="识别区域（Region JSON，留空使用整个显示器或客户区）" />
        <Button x:Name="PickRegion" Content="在显示器上框选区域" Click="SelectRegion" />
        <CheckBox x:Name="AllowExit" Content="允许输入越出识别区域" />
        <NumberBox x:Name="Frequency" Header="识别频率（Hz）" Minimum="0.1" Maximum="30" Value="1" />
        <NumberBox x:Name="Timeout" Header="总期限（毫秒，0 表示不限）" Minimum="0" Value="0" />
    </StackPanel></Expander>
    <CheckBox x:Name="EnableDebug" Content="启用已保存源码的断点" />
    <TextBlock Text="启动时固定目标、脚本和区域快照。本页修改用于下一次运行。" TextWrapping="Wrap" />
    <Button x:Name="Execute" Content="运行脚本" Style="{StaticResource AccentButtonStyle}" Click="StartRun" AutomationProperties.AutomationId="ExecuteScript" />
    <Button Content="重置本次草稿" Click="ResetDraft" />
    <TextBlock x:Name="Observation" TextWrapping="Wrap" AutomationProperties.AutomationId="MonitorObservation" />
    <Expander Header="全局快捷键" HorizontalAlignment="Stretch"><StackPanel Spacing="8">
        <TextBox x:Name="SelectionKey" Header="开始框选" />
        <TextBox x:Name="StopKey" Header="停止全部脚本" />
        <TextBox x:Name="PauseKey" Header="暂停或恢复选中的脚本" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="保存快捷键" Click="SaveKeys" /><Button Content="撤销编辑" Click="ReloadKeys" />
        </StackPanel>
    </StackPanel></Expander>
    <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
 </StackPanel></ScrollViewer>
</UserControl>
