<Window x:Class="ScreenTrigger.Selection.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ScreenTrigger · 选择区域">
    <Grid x:Name="Root" Background="#100B1522">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="EscapePressed" />
        </Grid.KeyboardAccelerators>
        <Canvas x:Name="Surface" Background="Transparent" PointerPressed="DragStarted"
                PointerMoved="DragMoved" PointerReleased="DragEnded" PointerCaptureLost="DragLost"
                PointerCanceled="DragLost">
            <Rectangle x:Name="Outline" Stroke="#FFFF27DC" StrokeThickness="2" IsHitTestVisible="False" />
        </Canvas>
        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12" Padding="12" CornerRadius="6"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" MaxWidth="320">
            <StackPanel Spacing="6">
                <TextBlock x:Name="Coordinates" Text="拖动选择区域 · Esc 取消" TextWrapping="Wrap" />
                <Image x:Name="PreviewImage" MaxWidth="260" MaxHeight="104" Stretch="Uniform" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ConfirmButton" AutomationProperties.AutomationId="ConfirmSelection"
                            Content="确认" IsEnabled="False" Click="ConfirmSelection" />
                    <Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelSelection"
                            Content="取消" Click="CancelSelection" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
