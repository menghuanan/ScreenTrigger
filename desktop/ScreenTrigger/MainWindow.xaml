<Window x:Class="ScreenTrigger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenTrigger" Title="ScreenTrigger">
    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel MaxWidth="820" Margin="32" Spacing="18" HorizontalAlignment="Stretch">
            <TextBlock Text="引擎状态" Style="{ThemeResource TitleTextBlockStyle}" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" />
            <Border CornerRadius="8" Padding="20" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="Health" Text="正在连接宿主…" AutomationProperties.AutomationId="EngineHealth"
                               AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="Versions" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="StartButton" Content="启动引擎" Click="StartEngine" IsEnabled="False"
                            AutomationProperties.AutomationId="StartEngine" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="StopButton" Content="停止引擎" Click="StopEngine" IsEnabled="False"
                            AutomationProperties.AutomationId="StopEngine" />
                        <Button x:Name="DiagnosticsButton" Content="查看诊断" Click="OpenDiagnostics" IsEnabled="False"
                            AutomationProperties.AutomationId="Diagnostics" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid x:Name="CapabilitiesHeader" Visibility="Collapsed" ColumnDefinitions="*,Auto">
                <TextBlock Text="当前能力" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Button x:Name="ModelsButton" Grid.Column="1" Content="查看 OCR 模型" IsEnabled="False"
                        AutomationProperties.AutomationId="InspectModels" Click="InspectModels" />
            </Grid>
            <TextBlock x:Name="ModelList" Visibility="Collapsed" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="InstalledModels" AutomationProperties.LiveSetting="Polite" />
            <ItemsControl x:Name="Capabilities" AutomationProperties.AutomationId="EngineCapabilities">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:CapabilityRow">
                        <StackPanel Margin="0,0,0,12" Spacing="3">
                            <TextBlock Text="{x:Bind Summary}" FontWeight="SemiBold" AutomationProperties.AutomationId="{x:Bind AutomationId}" />
                            <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>
