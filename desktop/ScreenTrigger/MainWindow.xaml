<Window x:Class="ScreenTrigger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenTrigger" Title="ScreenTrigger">
    <NavigationView x:Name="Navigation" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False" IsPaneToggleButtonVisible="False" SelectionChanged="Navigate">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="引擎" Tag="engine" IsSelected="True" AutomationProperties.AutomationId="NavEngine" />
            <NavigationViewItem Content="截图与导入" Tag="images" AutomationProperties.AutomationId="NavImages" />
            <NavigationViewItem Content="目标库" Tag="targets" AutomationProperties.AutomationId="NavTargets" />
            <NavigationViewItem x:Name="ScriptsNav" Content="脚本" Tag="scripts" AutomationProperties.AutomationId="NavScripts" />
            <NavigationViewItem x:Name="RecognitionNav" Content="测试识别" Tag="recognition" AutomationProperties.AutomationId="NavRecognition" />
            <NavigationViewItem Content="运行设置" Tag="run" AutomationProperties.AutomationId="NavRun" />
            <NavigationViewItem Content="区域监控" Tag="monitor" AutomationProperties.AutomationId="NavMonitor" />
            <NavigationViewItem Content="历史" Tag="history" AutomationProperties.AutomationId="NavHistory" />
            <NavigationViewItem Content="设置" Tag="settings" AutomationProperties.AutomationId="NavSettings" />
        </NavigationView.MenuItems>
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="*,Auto">
    <ScrollViewer x:Name="EnginePage">
        <StackPanel MaxWidth="820" Margin="32" Spacing="18" HorizontalAlignment="Stretch">
            <TextBlock Text="引擎状态" Style="{ThemeResource TitleTextBlockStyle}" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" />
            <Border CornerRadius="8" Padding="20" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="Health" Text="正在连接宿主…" AutomationProperties.AutomationId="EngineHealth"
                               AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="Versions" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="StartButton" Content="启动引擎" Click="StartEngine" IsEnabled="False"
                            AutomationProperties.AutomationId="StartEngine" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="StopButton" Content="停止引擎" Click="StopEngine" IsEnabled="False"
                            AutomationProperties.AutomationId="StopEngine" />
                        <Button x:Name="DiagnosticsButton" Content="查看诊断" Click="OpenDiagnostics" IsEnabled="False"
                            AutomationProperties.AutomationId="Diagnostics" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid x:Name="CapabilitiesHeader" Visibility="Collapsed" ColumnDefinitions="*,Auto">
                <TextBlock Text="当前能力" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Button x:Name="ModelsButton" Grid.Column="1" Content="查看 OCR 模型" IsEnabled="False"
                        AutomationProperties.AutomationId="InspectModels" Click="InspectModels" />
            </Grid>
            <TextBlock x:Name="ModelList" Visibility="Collapsed" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="InstalledModels" AutomationProperties.LiveSetting="Polite" />
            <ItemsControl x:Name="Capabilities" AutomationProperties.AutomationId="EngineCapabilities">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:CapabilityRow">
                        <StackPanel Margin="0,0,0,12" Spacing="3">
                            <TextBlock Text="{x:Bind Summary}" FontWeight="SemiBold" AutomationProperties.AutomationId="{x:Bind AutomationId}" />
                            <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="ImagePage" Visibility="Collapsed">
        <StackPanel Margin="32,24" MaxWidth="820" Spacing="12" HorizontalAlignment="Stretch">
            <TextBlock Text="截图与导入" Style="{ThemeResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SelectButton" Content="框选屏幕" Click="StartSelection" IsEnabled="False"
                        AutomationProperties.AutomationId="StartSelection" />
                <Button x:Name="ImportButton" Content="导入图片" Click="ImportImage" IsEnabled="False"
                        AutomationProperties.AutomationId="ImportImage" />
                <Button x:Name="CropButton" Content="裁剪…" Click="CropImage" IsEnabled="False"
                        AutomationProperties.AutomationId="CropImage" />
                <Button x:Name="OriginalButton" Content="返回原图" Click="RestoreOriginal" Visibility="Collapsed"
                        AutomationProperties.AutomationId="RestoreOriginal" />
            </StackPanel>
            <TextBlock x:Name="ImageStatus" AutomationProperties.AutomationId="ImageStatus"
                       AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
            <Image x:Name="SelectedImage" MaxHeight="380" HorizontalAlignment="Left" Stretch="Uniform" />
        </StackPanel>
    </ScrollViewer>
    <ContentControl x:Name="BusinessPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
        <StackPanel Grid.Row="1" Spacing="4" Margin="16,6">
          <TextBlock x:Name="ServiceStatus" Text="正在连接引擎…" AutomationProperties.AutomationId="ServiceStatus" />
          <TextBlock x:Name="ServiceNotice" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="ServiceNotice" AutomationProperties.LiveSetting="Polite" />
          <Grid x:Name="RunBar" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="6" Visibility="Collapsed">
            <ComboBox x:Name="ActiveExecution" MinWidth="120" AutomationProperties.Name="选中的执行"
                      AutomationProperties.AutomationId="ActiveExecution" SelectionChanged="SelectExecution" />
            <Button Grid.Column="1" x:Name="PauseExecutionButton" Content="暂停" Click="ToggleExecution" AutomationProperties.AutomationId="PauseExecution" />
            <Button Grid.Column="2" x:Name="StopExecutionButton" Content="停止" Click="StopExecution" AutomationProperties.AutomationId="StopExecution" />
            <Button Grid.Column="3" x:Name="InspectExecution" Content="查看断点" Click="InspectPaused" Visibility="Collapsed" />
            <TextBlock Grid.Column="4" x:Name="RunStatus" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="RunStatus" />
          </Grid>
        </StackPanel>
        </Grid>
    </NavigationView>
</Window>
