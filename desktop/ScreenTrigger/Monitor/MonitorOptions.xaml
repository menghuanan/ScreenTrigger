<UserControl x:Class="ScreenTrigger.Monitor.MonitorOptions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Spacing="8">
    <ComboBox x:Name="Hit" Header="命中后" SelectedIndex="0" SelectionChanged="Change">
      <ComboBoxItem Content="结束监控" /><ComboBoxItem Content="调用脚本" />
    </ComboBox>
    <StackPanel x:Name="HitFields" Spacing="6" Visibility="Collapsed">
      <ComboBox x:Name="ActionScript" Header="命中动作脚本" HorizontalAlignment="Stretch" />
      <TextBox x:Name="ActionArgs" Header="动作参数（JSON 对象，match 由引擎提供）" />
      <CheckBox x:Name="Repeat" Content="动作结束后继续监控" Click="ToggleRepeat" />
      <StackPanel x:Name="RepeatFields" Spacing="6" Visibility="Collapsed">
        <ComboBox x:Name="Trigger" Header="再次触发" SelectedIndex="0">
          <ComboBoxItem Content="消失后重新出现" /><ComboBoxItem Content="冷却后每次命中" />
        </ComboBox>
        <NumberBox x:Name="Cooldown" Header="动作后冷却（毫秒）" Minimum="0" Value="1000" />
      </StackPanel>
    </StackPanel>
    <NumberBox x:Name="WaitTimeout" Header="等待目标的时限（毫秒，0 表示不限）" Minimum="0" Value="30000" />
    <ComboBox x:Name="TimeoutPolicy" Header="等待超时后" SelectedIndex="0" SelectionChanged="Change">
      <ComboBoxItem Content="停止并报告超时" /><ComboBoxItem Content="有限重试" /><ComboBoxItem Content="调用失败处理脚本并结束" />
    </ComboBox>
    <StackPanel x:Name="RetryFields" Spacing="6" Visibility="Collapsed">
      <NumberBox x:Name="Retries" Header="最大重试次数" Minimum="1" Maximum="100" Value="1"/>
      <NumberBox x:Name="RetryDelay" Header="重试前等待（毫秒）" Minimum="0" Value="1000" />
    </StackPanel>
    <StackPanel x:Name="FailureFields" Spacing="6" Visibility="Collapsed">
      <ComboBox x:Name="TimeoutScript" Header="失败处理脚本" HorizontalAlignment="Stretch" />
      <TextBox x:Name="FailureArgs" Header="超时参数（JSON 对象，failure 由引擎提供）" />
    </StackPanel>
 </StackPanel>
</UserControl>
