<UserControl x:Class="ScreenTrigger.Targets.TargetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="10">
      <TextBlock Text="目标库" Style="{ThemeResource TitleTextBlockStyle}" />
      <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
        <TextBox x:Name="Query" Header="搜索目标" />
        <ComboBox x:Name="Filter" Header="分组筛选" Grid.Column="1" HorizontalAlignment="Stretch" />
        <Button Grid.Column="2" Content="查询" Tag="search" Click="Action" VerticalAlignment="Bottom" />
      </Grid>
      <ListView x:Name="Targets" Height="138" SelectionMode="Single" AutomationProperties.Name="目标列表" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="Previous" Content="上一页" Tag="previous" Click="Action" />
        <TextBlock x:Name="PageNumber" VerticalAlignment="Center" />
        <Button x:Name="Next" Content="下一页" Tag="next" Click="Action" />
        <Button Content="打开目标" Tag="open" Click="Action" />
        <Button Content="新建目标" Tag="new" Click="Action" />
      </StackPanel>
      <TextBox Header="目标名称" x:Name="TargetName" AutomationProperties.AutomationId="TargetName" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <ComboBox Header="目标分组" x:Name="TargetGroup" HorizontalAlignment="Stretch" />
        <ComboBox Header="保存图像" x:Name="Storage" SelectedIndex="0" Grid.Column="1">
          <ComboBoxItem Content="保留原图" /><ComboBoxItem Content="无损 PNG" />
        </ComboBox>
      </Grid>
      <CheckBox x:Name="ReplaceImage" Content="用当前截图或导入图片替换目标图像" />
      <TextBox x:Name="Anchor" Header="锚点条件 ID" Text="c1"/>
      <TextBox x:Name="Conditions" Header="识别条件（JSON）" AcceptsReturn="True" MinHeight="76"
               FontFamily="Consolas" TextChanged="ConditionsChanged" TextWrapping="Wrap" />
      <TreeView x:Name="Tree" Height="100" AutomationProperties.Name="识别条件树" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="保存目标" Tag="save" Click="Action" AutomationProperties.AutomationId="SaveTarget"/>
        <Button Content="删除目标" Tag="delete" Click="Action" />
        <Button Content="测试当前草稿" Tag="test" Click="Action" />
      </StackPanel>
      <Expander Header="分组管理" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="8">
          <ComboBox Header="要修改的分组" x:Name="Groups" HorizontalAlignment="Stretch" SelectionChanged="SelectGroup" />
          <TextBox Header="分组名称" x:Name="GroupName" />
          <ComboBox Header="父分组" x:Name="ParentGroup" HorizontalAlignment="Stretch" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="新建分组" Tag="group-new" Click="Action" />
            <Button Content="保存分组" Tag="group-save" Click="Action" />
            <Button Content="删除分组" Tag="group-delete" Click="Action" />
          </StackPanel>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
