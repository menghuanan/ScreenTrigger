<UserControl x:Class="ScreenTrigger.Scripts.ScriptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Margin="24" Spacing="10">
    <TextBlock Text="Lua 脚本" Style="{ThemeResource TitleTextBlockStyle}" />
    <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.AutomationId="ScriptFeedback" AutomationProperties.LiveSetting="Polite"/>
    <ListView x:Name="Scripts" Height="100" AutomationProperties.Name="已保存的脚本" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="Previous" Content="上一页" Click="Action" Tag="previous" />
      <Button x:Name="Next" Content="下一页" Click="Action" Tag="next" />
      <Button Content="打开脚本" Click="Action" Tag="open" />
      <Button Content="新建脚本" Click="Action" Tag="new" />
    </StackPanel>
    <TextBox Header="脚本名称" x:Name="ScriptName" AutomationProperties.AutomationId="ScriptName" />
    <TextBox Header="Lua 5.4 源码" x:Name="Source" AcceptsReturn="True" FontFamily="Consolas" MinHeight="150"
             AutomationProperties.AutomationId="ScriptSource" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    <Expander Header="参数声明" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <TextBox x:Name="Parameters" Header="参数列表（JSON）" Text="[]" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap" />
    </Expander>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="检查语法" Click="Action" Tag="validate" AutomationProperties.AutomationId="ValidateScript" />
      <Button Content="保存脚本" Click="Action" Tag="save" AutomationProperties.AutomationId="SaveScript" />
      <Button Content="打开调试器" Click="OpenDebug" AutomationProperties.AutomationId="OpenDebug" />
      <Button Content="删除脚本" Click="Action" Tag="delete" />
    </StackPanel>
    <ContentControl x:Name="DebugTools" HorizontalContentAlignment="Stretch" />
 </StackPanel></ScrollViewer>
</UserControl>
