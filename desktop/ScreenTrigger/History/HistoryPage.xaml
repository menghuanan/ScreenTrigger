<UserControl x:Class="ScreenTrigger.History.HistoryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Margin="24" Spacing="8">
   <TextBlock Text="执行历史" Style="{ThemeResource TitleTextBlockStyle}" />
   <ListView x:Name="Runs" MaxHeight="200" SelectionChanged="Selected" AutomationProperties.Name="执行记录" />
   <StackPanel Orientation="Horizontal" Spacing="6">
     <Button x:Name="PrevRuns" Content="上一页执行" Click="Browse" Tag="runs-prev" />
     <Button x:Name="NextRuns" Content="下一页执行" Click="Browse" Tag="runs-next" />
     <Button Content="刷新历史" Click="Browse" Tag="refresh" AutomationProperties.AutomationId="RefreshHistory" />
   </StackPanel>
   <TextBlock x:Name="Summary" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
   <TextBlock x:Name="Entries" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="HistoryLogs" />
   <StackPanel Orientation="Horizontal" Spacing="6">
     <Button x:Name="PrevLogs" Content="上一页日志" Click="Browse" Tag="logs-prev" />
     <Button x:Name="NextLogs" Content="下一页日志" Click="Browse" Tag="logs-next" />
     <Button x:Name="Clear" Content="清除这次执行的日志…" Click="Browse" Tag="clear" />
   </StackPanel>
   <Expander x:Name="RequestLookup" Header="查询本会话的请求" HorizontalAlignment="Stretch">
     <StackPanel Spacing="6"><TextBox x:Name="RequestId" Header="请求 ID" /><Button Content="查询状态" Click="Browse" Tag="query" /></StackPanel>
   </Expander>
   <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.AutomationId="HistoryFeedback" AutomationProperties.LiveSetting="Polite" />
 </StackPanel></ScrollViewer>
</UserControl>
