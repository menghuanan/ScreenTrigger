<UserControl x:Class="ScreenTrigger.Settings.SettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Margin="24" Spacing="10">
   <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />
   <TextBlock x:Name="Location" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
   <TextBlock x:Name="Recovery" TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigRecovery" AutomationProperties.LiveSetting="Polite" />
   <Expander Header="离线 OCR 模型" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="OcrModelLibrary">
     <StackPanel Spacing="8">
       <ComboBox x:Name="OcrPipelines" Header="选择管线" MinWidth="280" AutomationProperties.AutomationId="OcrPipelines" />
       <TextBlock x:Name="ModelInfo" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="ModelInfo" AutomationProperties.LiveSetting="Polite"/>
       <StackPanel Orientation="Horizontal" Spacing="8">
         <Button Content="刷新状态" Click="RefreshModels" />
         <Button Content="从本地目录导入…" Click="ImportModel" AutomationProperties.AutomationId="ImportOcrModel" />
         <Button Content="移除…" Click="RemoveModel" AutomationProperties.AutomationId="RemoveOcrModel" />
       </StackPanel>
     </StackPanel>
   </Expander>
   <Expander Header="目标与脚本备份" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CatalogBackups">
     <StackPanel Spacing="8">
       <Button Content="创建备份" Click="CreateBackup" AutomationProperties.AutomationId="CreateBackup" />
       <ComboBox x:Name="Backups" Header="选择备份" MinWidth="260" AutomationProperties.AutomationId="BackupList" />
       <Button Content="预览恢复…" Click="RestoreBackup" AutomationProperties.AutomationId="PreviewRestore" />
     </StackPanel>
   </Expander>
   <StackPanel x:Name="Groups" Spacing="6" />
   <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="保存设置" Click="Save" AutomationProperties.AutomationId="SaveSettings" />
      <Button Content="撤销编辑" Click="Cancel" AutomationProperties.AutomationId="CancelSettings" />
      <Button Content="恢复默认值…" Click="Reset" AutomationProperties.AutomationId="ResetSettings" />
      <Button Content="重新读取" Click="Reload" />
   </StackPanel>
   <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsFeedback" AutomationProperties.LiveSetting="Polite" />
 </StackPanel></ScrollViewer>
</UserControl>
