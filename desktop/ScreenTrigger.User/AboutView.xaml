<UserControl x:Class="ScreenTrigger.User.AboutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,0,6">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Background="#336CAD" CornerRadius="12" Width="52" Height="52">
                            <ContentPresenter Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="ScreenTrigger" ContentTemplate="{StaticResource AppMark}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="ScreenTrigger" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="欢迎使用测试版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="VersionLabel" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}"><Grid>
                    <TextBlock Text="项目主页" VerticalAlignment="Center"/>
                    <HyperlinkButton HorizontalAlignment="Right" Content="打开主页　↗" NavigateUri="https://github.com/menghuanan/ScreenTrigger" AutomationProperties.Name="打开项目主页"/>
                </Grid></Border>
                <Border Style="{StaticResource Card}"><Grid>
                    <TextBlock Text="反馈问题" VerticalAlignment="Center"/>
                    <HyperlinkButton HorizontalAlignment="Right" Content="前往反馈　↗" NavigateUri="https://github.com/menghuanan/ScreenTrigger/issues" AutomationProperties.Name="打开问题反馈"/>
                </Grid></Border>
                <Border Style="{StaticResource Card}"><Grid>
                    <TextBlock Text="更新日志" VerticalAlignment="Center"/>
                    <HyperlinkButton HorizontalAlignment="Right" Content="查看版本　↗" NavigateUri="https://github.com/menghuanan/ScreenTrigger/releases" AutomationProperties.Name="打开更新日志"/>
                </Grid></Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="CheckButton" Content="检查更新" Click="Check" VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="CheckUpdates"/>
            <TextBlock Grid.Column="1" x:Name="Result" VerticalAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="UpdateResult"/>
        </Grid>
    </Grid>
</UserControl>
