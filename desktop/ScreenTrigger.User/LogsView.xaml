<UserControl x:Class="ScreenTrigger.User.LogsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="日志" Style="{StaticResource PageTitle}"/>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="Category" SelectedIndex="0" SelectionChanged="CategoryChanged" AutomationProperties.Name="日志类型">
                <ComboBoxItem Content="执行日志"/><ComboBoxItem Content="应用日志"/>
            </ComboBox>
            <ComboBox x:Name="Runs" Grid.Column="1" HorizontalAlignment="Left" MinWidth="176" MaxWidth="280" PlaceholderText="暂无执行记录" AutomationProperties.Name="执行记录" AutomationProperties.AutomationId="ExecutionRuns" SelectionChanged="RunChanged"/>
            <Button Grid.Column="2" Content="刷新" Click="Refresh" AutomationProperties.AutomationId="RefreshLogs"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <ListView x:Name="AppLog" Visibility="Collapsed" SelectionMode="None" AutomationProperties.Name="应用日志"/>
                <Grid x:Name="History" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer x:Name="LogScroll"><TextBlock x:Name="Entries" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="13" AutomationProperties.AutomationId="LogEntries"/></ScrollViewer>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="Previous" Content="上一页" Click="Prev" IsEnabled="False"/><Button x:Name="Next" Content="下一页" Click="More" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
