<UserControl x:Class="ScreenTrigger.User.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:host="using:ScreenTrigger.Host">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideEngineCard">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EngineSummary.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="EngineActions.(Grid.Row)" Value="0"/>
                        <Setter Target="EngineActions.(Grid.Column)" Value="2"/>
                        <Setter Target="EngineActions.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="EngineActions.Margin" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="10">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="SettingsTitle"/>
            <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,0,6">
                <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Border Width="52" Height="52" Background="#336CAD" CornerRadius="12" VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE950;" Foreground="White" FontSize="24"/>
                    </Border>
                    <StackPanel x:Name="EngineSummary" Grid.Column="1" Grid.ColumnSpan="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="引擎" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock x:Name="Health" Text="正在连接宿主…" TextWrapping="Wrap" AutomationProperties.AutomationId="EngineHealth"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="Versions" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.AutomationId="EngineVersions" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel x:Name="EngineActions" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="StartButton" Content="启动引擎" Click="StartEngine" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="StartEngine"/>
                        <Button x:Name="StopButton" Content="停止引擎" Click="StopEngine" IsEnabled="False" AutomationProperties.AutomationId="StopEngine"/>
                        <Button x:Name="DiagnosticsButton" Content="查看诊断" Click="ToggleDiagnostics" IsEnabled="False" AutomationProperties.AutomationId="Diagnostics"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" x:Name="EngineError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Border>
            <Border x:Name="DiagnosticsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="引擎诊断" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" x:Name="RefreshDiagnosticsButton" Content="刷新诊断" Click="RefreshDiagnostics"
                                AutomationProperties.AutomationId="RefreshDiagnostics"/>
                    </Grid>
                    <TextBlock x:Name="DiagnosticsDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               AutomationProperties.AutomationId="EngineDiagnostics" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <Expander x:Name="CapabilitiesPanel" Header="当前能力" Visibility="Collapsed" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="EngineCapabilitiesPanel">
                <StackPanel Spacing="8">
                    <ItemsControl x:Name="Capabilities" AutomationProperties.AutomationId="EngineCapabilities">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="host:CapabilityRow">
                                <StackPanel Spacing="2" Margin="0,0,0,10">
                                    <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="{x:Bind AutomationId}"/>
                                    <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="ModelsButton" Content="查看 OCR 模型" Click="InspectModels" IsEnabled="False"
                            AutomationProperties.AutomationId="InspectModels"/>
                    <TextBlock x:Name="ModelList" Visibility="Collapsed" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="InstalledModels" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Expander>
            <ContentControl x:Name="PreferencesHost" HorizontalContentAlignment="Stretch"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
