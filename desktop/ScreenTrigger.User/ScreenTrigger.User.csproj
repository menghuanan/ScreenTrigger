<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ScreenTrigger</AssemblyName>
    <Version>0.1.0-beta.1</Version>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ScreenTrigger.Client/ScreenTrigger.Client.csproj" />
    <Compile Include="../ScreenTrigger/WorkspaceCommands.cs" Link="WorkspaceCommands.cs" />
    <Compile Include="../ScreenTrigger/Settings/SettingsPage.xaml.cs" Link="SettingsPage.xaml.cs" />
    <Page Include="../ScreenTrigger/Selection/OverlayWindow.xaml" Link="Selection/OverlayWindow.xaml" />
    <Compile Include="../ScreenTrigger/Selection/*.cs" Link="Selection/%(Filename)%(Extension)" />
    <Compile Include="../ScreenTrigger/Import/ImagePicker.cs;../ScreenTrigger/Import/TextOutputPicker.cs" Link="Import/%(Filename)%(Extension)" />
    <Compile Include="../../tools/probes/windows/SelectionProbe/SelectionGeometry.cs;../../tools/probes/windows/SelectionProbe/ProbeDesktop.cs" Link="Selection/%(Filename)%(Extension)" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="../NativeHost.targets" />
  <Target Name="CreatePortableEntry" BeforeTargets="WriteUserPublishInventory" Condition="'$(ScreenTriggerPortable)' == 'true'"
          DependsOnTargets="_GetAppHostPaths;AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <PropertyGroup>
      <_PortableEntry>$(PublishDir)/portable/ScreenTrigger.exe</_PortableEntry>
      <_PortableManifest>$(IntermediateOutputPath)Manifests/portable-sdk.manifest</_PortableManifest>
    </PropertyGroup>
    <MakeDir Directories="$(PublishDir)/portable"/>
    <!-- Use the SDK apphost so the window, arguments and exit code belong to the root EXE. -->
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)" AppHostDestinationPath="$(_PortableEntry)"
                   AppBinaryName="resources/ui/ScreenTrigger.dll" DotNetSearchLocations="AppLocal"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')" WindowsGraphicalUserInterface="true"/>
    <GenerateAppManifestFromAppxFragments RedirectDlls="true" FrameworkDlls="@(MicrosoftWindowsAppSDKDllFiles)"
                                          AppxFragments="@(MicrosoftWindowsAppSDKAppxFragmentFiles)" OutAppManifest="$(_PortableManifest)"/>
    <Exec Command="&quot;$(ManifestTool)&quot; -nologo -manifest &quot;$(_PortableManifest)&quot; &quot;$(MSBuildProjectDirectory)/app.manifest&quot; -outputresource:&quot;$(_PortableEntry);#1&quot;"/>
    <ItemGroup>
      <ResolvedFileToPublish Include="$(_PortableEntry)" RelativePath="portable/ScreenTrigger.exe" />
    </ItemGroup>
  </Target>
  <Target Name="WriteUserPublishInventory" AfterTargets="Publish">
    <GetFileHash Files="@(ResolvedFileToPublish)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_UserPublishFile" />
    </GetFileHash>
    <WriteLinesToFile File="$(PublishDir)/ScreenTrigger.User.files"
        Lines="@(_UserPublishFile->'%(RelativePath)|%(FileHash)')" Encoding="UTF-8" Overwrite="true" />
  </Target>
</Project>
