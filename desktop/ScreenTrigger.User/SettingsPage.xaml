<UserControl x:Class="ScreenTrigger.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="10">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideSettings">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OcrModelLibrary.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="CatalogBackups.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="CatalogBackups.(Grid.Column)" Value="1"/>
                        <Setter Target="CatalogBackups.(Grid.Row)" Value="0"/>
                        <Setter Target="CatalogBackups.Margin" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="Location" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="Recovery" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.AutomationId="ConfigRecovery"
                   AutomationProperties.LiveSetting="Polite"/>
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12">
            <Expander x:Name="OcrModelLibrary" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" Header="离线 OCR 模型" AutomationProperties.AutomationId="OcrModelLibrary">
                <StackPanel Spacing="8">
                    <ComboBox x:Name="OcrPipelines" Header="选择管线" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="OcrPipelines"/>
                    <TextBlock x:Name="ModelInfo" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="ModelInfo"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button Content="刷新状态" Click="RefreshModels"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="从本地目录导入…" Click="ImportModel" AutomationProperties.AutomationId="ImportOcrModel"/>
                        <Button Content="移除…" Click="RemoveModel" AutomationProperties.AutomationId="RemoveOcrModel"/>
                    </StackPanel>
                </StackPanel>
            </Expander>
            <Expander x:Name="CatalogBackups" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" Margin="0,10,0,0" Header="目标与脚本备份" AutomationProperties.AutomationId="CatalogBackups">
                <StackPanel Spacing="8">
                    <Button Content="创建备份" Click="CreateBackup" AutomationProperties.AutomationId="CreateBackup"/>
                    <ComboBox x:Name="Backups" Header="选择备份" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="BackupList"/>
                    <Button Content="预览恢复…" Click="RestoreBackup" AutomationProperties.AutomationId="PreviewRestore"/>
                </StackPanel>
            </Expander>
        </Grid>
        <StackPanel x:Name="Groups" Spacing="6"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="保存设置" Click="Save" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SaveSettings"/>
            <Button Content="撤销编辑" Click="Cancel" AutomationProperties.AutomationId="CancelSettings"/>
            <Button Content="恢复默认值…" Click="Reset" AutomationProperties.AutomationId="ResetSettings"/>
            <Button Content="重新读取" Click="Reload" AutomationProperties.AutomationId="ReloadSettings"/>
        </StackPanel>
        <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsFeedback" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
