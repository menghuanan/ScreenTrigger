<UserControl x:Class="ScreenTrigger.User.GroupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="目标分组" Style="{StaticResource PageTitle}"/>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="Filter" MaxWidth="260" HorizontalAlignment="Stretch" AutomationProperties.Name="目标分组" AutomationProperties.AutomationId="GroupFilter" SelectionChanged="FilterChanged"/>
            <Button Grid.Column="1" Content="新建分组" Style="{StaticResource AccentButtonStyle}" Click="NewGroup" AutomationProperties.AutomationId="NewGroup"/>
            <Button Grid.Column="2" x:Name="RenameButton" Content="重命名" Click="Rename"/>
            <Button Grid.Column="3" x:Name="DeleteButton" Content="删除" Click="Delete"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><TextBlock x:Name="Count" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <Button x:Name="MoveButton" Content="移动到分组" HorizontalAlignment="Right" Click="Move" IsEnabled="False"/>
                </Grid>
                <ListView Grid.Row="1" x:Name="Targets" AutomationProperties.Name="目标" SelectionChanged="TargetChanged"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
