<UserControl x:Class="ScreenTrigger.User.GroupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="目标库" Style="{StaticResource PageTitle}"/>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="分组" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="新建分组" Click="NewGroup" AutomationProperties.AutomationId="NewGroup"/>
                    </Grid>
                    <TreeView x:Name="LibraryTree" Grid.Row="1" CanDragItems="False" CanReorderItems="False" AllowDrop="False"
                        ItemInvoked="OpenNode" AutomationProperties.Name="分组与目标" AutomationProperties.AutomationId="TargetTree"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="RenameButton" Content="重命名" Click="RenameGroup" IsEnabled="False" AutomationProperties.AutomationId="RenameButton"/>
                        <Button x:Name="DeleteButton" Content="删除组" Click="DeleteGroup" IsEnabled="False" AutomationProperties.AutomationId="DeleteButton"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="TargetTitle" Text="新建目标" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="NewTargetButton" Content="新建" Visibility="Collapsed" Click="NewTarget" AutomationProperties.AutomationId="NewTarget"/>
                            <Button Grid.Column="2" Content="保存" Style="{StaticResource AccentButtonStyle}" Click="Save" AutomationProperties.AutomationId="SaveTarget"/>
                        </Grid>
                        <TextBox x:Name="TargetName" Header="目标名称" PlaceholderText="输入名称" MaxLength="100" AutomationProperties.AutomationId="TargetName"/>
                        <ComboBox x:Name="TargetGroup" Header="分组" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="TargetGroup"/>
                        <TextBlock Text="快捷导入" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SelectButton" Content="框选屏幕" Click="SelectImage" AutomationProperties.AutomationId="SelectTargetImage"/>
                            <Button x:Name="ImportButton" Content="导入图片" Click="ImportImage" AutomationProperties.AutomationId="ImportTargetImage"/>
                        </StackPanel>
                        <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8">
                            <Grid MinHeight="130" Height="180">
                                <TextBlock x:Name="PreviewHint" Text="目标预览" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="目标预览" AutomationProperties.AutomationId="TargetPreview"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="Details" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
