<UserControl x:Class="ScreenTrigger.User.ScriptsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:ScreenTrigger.User" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid x:Name="Library" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="编辑脚本" Style="{StaticResource PageTitle}"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="NewButton" AutomationProperties.Name="新建" AutomationProperties.AutomationId="NewScript" Style="{StaticResource AccentButtonStyle}" Click="NewScript">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="新建"/></StackPanel>
                </Button>
                <Button x:Name="RecordButton" Content="录制脚本" Click="StartRecording" AutomationProperties.AutomationId="RecordScript"/>
            </StackPanel>
            <Border Grid.Row="2" x:Name="RecordingPanel" Visibility="Collapsed" Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="RecordingStatus" VerticalAlignment="Center" Text="正在录制" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="ContinueRecording" Content="恢复录制" Click="ResumeRecording" Visibility="Collapsed"/>
                    <Button Content="结束并编辑" Click="FinishRecording" AutomationProperties.AutomationId="FinishRecording"/>
                    <Button Content="取消录制" Click="CancelRecording" AutomationProperties.AutomationId="CancelRecording"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <TextBlock x:Name="EmptyLibrary" Text="还没有脚本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ListView x:Name="ScriptList" SelectionMode="None" AutomationProperties.Name="已有脚本" AutomationProperties.AutomationId="ScriptList">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,6"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="local:ScriptRow">
                            <Grid ColumnSpacing="8" MinHeight="48">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind RevisionLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="编辑" Click="EditScript" AutomationProperties.AutomationId="{x:Bind EditId}"/>
                                <Button Grid.Column="2" Content="删除" Click="DeleteScript" AutomationProperties.AutomationId="{x:Bind DeleteId}"/>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="Editor" Visibility="Collapsed" RowSpacing="12" SizeChanged="EditorSized">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="EditorTitle" Style="{StaticResource PageTitle}"/>
            <Grid Grid.Row="1" x:Name="Toolbar" ColumnSpacing="8" RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ScriptName" VerticalAlignment="Center" PlaceholderText="脚本名称" MaxLength="100" AutomationProperties.Name="脚本名称" AutomationProperties.AutomationId="ScriptName"/>
                <ToggleSwitch x:Name="ModeSwitch" Grid.Column="1" OnContent="Lua" OffContent="装配台" MinWidth="104" VerticalAlignment="Center" ToolTipService.ToolTip="在装配台和 Lua 编辑器之间切换"
                    Toggled="SwitchMode" AutomationProperties.Name="切换装配台与 Lua 模式" AutomationProperties.AutomationId="ScriptMode"/>
                <StackPanel x:Name="LibraryPicker" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="目标库" VerticalAlignment="Center"/><ComboBox x:Name="GroupFilter" Width="124" AutomationProperties.Name="可选目标分组" AutomationProperties.AutomationId="EditorTargetGroup"/>
                </StackPanel>
                <StackPanel x:Name="EditorActions" Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="保存" Style="{StaticResource AccentButtonStyle}" Click="Save" AutomationProperties.AutomationId="SaveScript"/>
                    <Button Content="取消" Click="Back" AutomationProperties.AutomationId="BackScripts"/>
                </StackPanel>
            </Grid>
            <local:AssemblyView x:Name="Assembly" Grid.Row="2"/>
            <Grid Grid.Row="2" x:Name="LuaPanel" Visibility="Collapsed" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="检查语法" Click="CheckSyntax" AutomationProperties.AutomationId="CheckLua"/>
                    <DropDownButton Content="插入目标引用"><DropDownButton.Flyout><MenuFlyout Opening="ListLuaTargets"/></DropDownButton.Flyout></DropDownButton>
                    <TextBlock x:Name="SyntaxResult" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <TextBox Grid.Row="1" x:Name="Source" TextChanged="SourceChanged" AcceptsReturn="True" TextWrapping="Wrap" Padding="14"
                    FontFamily="Consolas" FontSize="14" VerticalContentAlignment="Top" IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Lua 脚本内容" AutomationProperties.AutomationId="ScriptSource"/>
            </Grid>
            <Grid Grid.Row="3" x:Name="ExportOptions" Visibility="Collapsed" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="选择 TXT 保存位置…" Click="ChooseExportFile" AutomationProperties.AutomationId="PickEditorOutput"/>
                <TextBlock Grid.Column="1" x:Name="ExportPath" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="EditorOutputPath"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
