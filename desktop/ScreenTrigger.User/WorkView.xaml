<UserControl x:Class="ScreenTrigger.User.WorkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="开始工作" Style="{StaticResource PageTitle}"/>
        <ScrollViewer x:Name="Options" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <ComboBox x:Name="Scope" Header="选择操作区域" PlaceholderText="选择显示器或窗口" HorizontalAlignment="Stretch"
                            SelectionChanged="ScopeChanged" AutomationProperties.AutomationId="WorkScope"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="刷新窗口" Click="RefreshWindows" AutomationProperties.AutomationId="RefreshWindows"/>
                            <Button x:Name="PickButton" Content="框选区域" Click="PickRegion" AutomationProperties.AutomationId="PickWorkRegion"/>
                            <CheckBox x:Name="BackgroundMode" Content="后台运行" IsEnabled="False" ToolTipService.ToolTip="选择窗口后可启用后台运行" AutomationProperties.AutomationId="WorkBackground"/>
                        </StackPanel>
                        <StackPanel x:Name="RegionDetails" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="RegionText" VerticalAlignment="Center"/>
                            <Button Content="清除选区" Click="ClearRegion"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="Script" Header="选择脚本" PlaceholderText="请先在编辑脚本页保存脚本" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WorkScript" SelectionChanged="OptionsChanged"/>
                            <ComboBox x:Name="Mode" Grid.Column="1" Header="运行模式" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OptionsChanged" AutomationProperties.AutomationId="WorkMode">
                                <ComboBoxItem Content="单次"/><ComboBoxItem Content="指定次数"/>
                            </ComboBox>
                            <NumberBox x:Name="Count" Grid.Column="2" Header="次数" Minimum="1" Maximum="2147483647" Value="1" SmallChange="1" IsEnabled="False" AutomationProperties.AutomationId="WorkCount"/>
                        </Grid>
                        <Expander Header="脚本参数与 OCR 导出" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <TextBox x:Name="Arguments" Header="脚本参数（JSON 对象）" Text="{}"/>
                                <ComboBox x:Name="OutputMode" Header="TXT 输出" SelectedIndex="0">
                                    <ComboBoxItem Content="按脚本需要选择文件"/><ComboBoxItem Content="追加到 TXT"/><ComboBoxItem Content="覆盖 TXT"/>
                                </ComboBox>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock x:Name="RunStatus" TextWrapping="Wrap" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="WorkStatus"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button x:Name="ResumeButton" Content="恢复" Click="Resume" Visibility="Collapsed"/>
                <Button x:Name="StartButton" Content="开始" MinWidth="200" Height="40" Style="{StaticResource AccentButtonStyle}" Click="StartOrStop" AutomationProperties.AutomationId="StartWork"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
