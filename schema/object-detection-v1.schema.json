{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "screentrigger://schema/object-detection-v1.schema.json",
  "title": "Object detection provider contract v1",
  "oneOf": [
    {"$ref": "#/definitions/model"}, {"$ref": "#/definitions/request"}, {"$ref": "#/definitions/result"}
  ],
  "definitions": {
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "model_id", "version", "class_ids", "input_width", "input_height", "input_format", "resize", "output_layout", "external_nms"],
      "properties": {
        "contract_version": {"const": 1}, "model_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "class_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "input_width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "input_height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "input_format": {"const": "RGB_NCHW_FLOAT32_0_1"}, "resize": {"const": "letterbox_center_114"},
        "output_layout": {"const": "N_XYXY_SCORE_CLASS"}, "external_nms": {"type": "boolean"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "class_id", "threshold", "roi"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1}, "class_id": {"type": "integer", "minimum": 0},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "roi": {"$ref": "types.schema.json#/definitions/rect"}
      }
    },
    "instance": {
      "type": "object", "additionalProperties": false,
      "required": ["class_id", "confidence", "bbox", "center", "space"],
      "properties": {
        "class_id": {"type": "integer", "minimum": 0}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox": {"$ref": "types.schema.json#/definitions/rect"},
        "center": {"$ref": "types.schema.json#/definitions/point"},
        "space": {"enum": ["image_pixel", "screen_physical", "window_client_physical"]}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["frame_id", "geometry_revision", "matches", "truncated"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1}, "geometry_revision": {"type": "integer", "minimum": 0},
        "matches": {"type": "array", "maxItems": 100, "items": {"$ref": "#/definitions/instance"}},
        "truncated": {"type": "boolean"}
      }
    }
  }
}
